@*Model sẽ được truyền giữa trang Partial View và trang cha*@
@model BE_MyStore_25DH110986.Models.Category

@*Các phần chung của 2 form Edit.cshtml và Create.cshtml*@
<div class="form-group">
    <div class="control-label col-md-2">Tên danh mục</div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.CategoryName,
       new { htmlAttributes = new { @class = "form-control"}})
        @Html.ValidationMessageFor(model => model.CategoryName, "",
       new { @class = "text-danger"})
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Lưu" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null,
       new { @class = "btn btn-primary" })
    </div>
</div>





