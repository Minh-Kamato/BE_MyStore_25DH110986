@model BE_MyStore_25DH110986.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>

<h3 class="alert-danger">Bạn thực sự muốn xóa sản phẩm này à?</h3>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <div class="form-group">
            <div class="control-label col-md-2">Tên danh mục</div>
            <div class="col-md-10">
                @*Hiện thị giá trị của CategoryName*@
                @Html.DisplayFor(model => model.CategoryName)
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Xóa" class="btn btn-primary" />
                    @Html.ActionLink("Quay lại danh sách", "Index", null,
                   new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    </div>
}
